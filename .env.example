# Environment Configuration Example for TeamHub Portal
# Copy this file to .env for local PostgreSQL or deployed production use.
# If DATABASE_URL is left empty during local development, TeamHub uses embedded PGLite.

# Database: Supabase PostgreSQL connection string
DATABASE_URL=

# Better Auth Configuration
BETTER_AUTH_SECRET=teamhub_super_secret_local_key_32_chars_minimum!
BETTER_AUTH_URL=http://localhost:8080

# Application URL
APP_URL=http://localhost:8080

# Supabase Storage & Realtime (Free Tier)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend Transactional Email (Free Tier)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TeamHub Notifications <notifications@rvit.ac.in>

# Optional Federated OAuth (Google / X)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
